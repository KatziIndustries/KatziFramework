<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>KatziFramework</PackageId>
    <Authors>AaronoLW</Authors>
    <Version>2.2.4</Version>
    <Copyright>Copyright 2026 AaronoLW</Copyright>
    <PackageProjectUrl>https://github.com/KatziIndustries/KatziFramework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KatziIndustries/KatziFramework.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>A fork of the SmashFramework with better integration into the *Katzi ecosystem*</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="KatziError.Net" Version="1.0.3" />
	  <PackageReference Include="SDL3-CS" Version="3.4.20"></PackageReference>
	  <PackageReference Include="SDL3-CS.Native" Version="3.4.2" />
	  <PackageReference Include="SDL3-CS.Native.Image" Version="3.5.0" />
	  <PackageReference Include="SDL3-CS.Native.TTF" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Test/**" />
  </ItemGroup>
  
</Project>
